NUXT_SESSION_PASSWORD=
TURSO_DB_URL=
TURSO_DB_TOKEN=
APP_URL=http://localhost:3000

# Emails transactionnels (Resend). Sans RESEND_API_KEY, les emails sont
# journalisés dans la console au lieu d'être envoyés (dev).
RESEND_API_KEY=
RESEND_FROM=QVault <noreply@qvault.hqmerchant.xyz>

# Optional partner catalog for the public Support page.
# Fields: id, kind ("sponsor" or "affiliate"), title, description, url,
# disclosure. Set [] to disable the public partner catalogue.
SUPPORT_CATALOG_JSON=[]
